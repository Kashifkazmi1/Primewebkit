# Copy to .env.local for development, or set these in your hosting
# platform's environment configuration for production.

# Public site origin (this Next.js app).
NEXT_PUBLIC_SITE_URL=https://primewebkit.com

# Backend API base URL. The backend runs on its own subdomain
# (api.primewebkit.com), separate from this frontend — a cross-origin
# setup, so the backend's CORS_ALLOWED_ORIGINS must include
# https://primewebkit.com. For local development against a
# locally-running PHP backend, point this at that server directly,
# e.g. http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=https://api.primewebkit.com/api/v1

# Public Google OAuth client ID (not a secret) for Google Identity
# Services sign-in. Must match the backend's GOOGLE_CLIENT_ID and have
# primewebkit.com registered as an Authorized JavaScript origin in
# Google Cloud Console.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1044212666179-nmo21qhhgr7hc4n8sdm34ccsgs5sdo84.apps.googleusercontent.com

# Hosted checkout page for paid plans. This app never collects payment
# details itself — every "Upgrade" button is a plain link out to this
# URL, opened in a new tab.
NEXT_PUBLIC_UPGRADE_BASIC_URL=https://pay.primewebkit.com/ai/basic-plan/
