# Security headers — equivalent to the next.config.ts headers() that
# don't run in static-export mode (no Node.js server to apply them).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # /chat is meant to be embedded in an iframe on customer sites, so it's
  # excluded from the frame-restriction everything else gets.
  <If "%{REQUEST_URI} !~ m#^/chat#">
    Header always set X-Frame-Options "SAMEORIGIN"
  </If>
</IfModule>

# Pretty URLs. This Next.js version's static export does NOT write
# <route>/index.html — the real page is always the flat <route>.html
# file; <route>/ (when it exists at all, because some other route is
# nested under it) holds only client-navigation payload files, never a
# renderable page. So: whenever a flat "<path>.html" export exists on
# disk, serve it — regardless of whether <path> also happens to exist
# as a directory. Deliberately does NOT branch on -f/-d for <path>
# itself, since that distinction is what silently broke this on some
# server configurations.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*[^/])/?$ $1.html [L]
</IfModule>

# Custom 404 page (Next exports one at build time).
ErrorDocument 404 /404.html
